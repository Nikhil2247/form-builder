{
  "name": "form-builder-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "// build": "Clean first. The incremental cache lives in dist (see tsconfig.build.json), so removing dist removes it too — the two can never disagree about what has been emitted.",
    "prebuild": "rimraf dist",
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "// worker": "Queue consumer process. Deploy separately from the API and scale on queue depth.",
    "start:worker": "PROCESS_ROLE=worker node dist/worker",
    "start:worker:dev": "PROCESS_ROLE=worker bun --watch src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "// db:seed:choices": "Platform-global reference lists (India states/districts). Idempotent and production-safe, unlike db:seed which truncates.",
    "db:seed:choices": "bun prisma/seed-choice-lists.ts",
    "// db:seed:nagaland": "Buildability test: rebuilds the Samagra Shiksha Nagaland monitoring form as configuration, with responses. Needs db:seed and db:seed:choices first. Prints a verdict on what the platform can and cannot express.",
    "db:seed:nagaland": "bun prisma/seed-nagaland-app.ts",
    "// db:seed:real": "Wipes every table and creates only the real Vibha orgs (Punjab PMU, Nagaland PMU) and their real users plus one super admin. No confirmation prompt — runs immediately. Not for local dev data — see db:seed.",
    "db:seed:real": "bun prisma/seed-real-orgs.ts",
    "db:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/lib-storage": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@google/genai": "^2.15.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7",
    "@sentry/nestjs": "^10.70.0",
    "argon2": "^0.45.1",
    "axios": "^1.19.0",
    "bullmq": "6",
    "cache-manager": "^7.2.9",
    "cache-manager-ioredis-yet": "^2.1.2",
    "chalk": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "6",
    "ipaddr.js": "^2.5.0",
    "joi": "^18.2.3",
    "minio": "^8.0.7",
    "nanoid": "^6.0.1",
    "nest-winston": "^1.10.2",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.3",
    "otplib": "13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma-extension-pagination": "^0.7.6",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.4",
    "@types/pino": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.9.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "7",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "moduleResolution": "node",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(?:otplib|@otplib|@scure|@noble|nanoid|chalk|uuid)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
