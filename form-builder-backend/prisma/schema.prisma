// ============================================================================
// PRISMA SCHEMA — FormBuilder NestJS Backend (Multi-Tenant)
// Database: PostgreSQL 16+
// ORM:      Prisma 5.x
// Mode:     Multi-tenant with Organization-scoped data isolation
//
// ARCHITECTURE DECISIONS:
// ─────────────────────────────────────────────────────────────────────────────
// 1. UUID primary keys (uuid()) — globally unique, safe for distributed
//    or sharded environments. No sequential ID leakage.
//
// 2. JSONB columns for dynamic data (answers, theme, logic rules, question
//    structure) — avoids hundreds of EAV join tables while keeping deep
//    queryability via GIN indexes.
//
// 3. Form versioning (FormVersion) — immutable snapshot of questions/logic
//    at the time a form is published. Submissions always point to the exact
//    version they were filled against. Critical for audit trails and
//    result accuracy when the creator edits live forms.
//
// 4. Multi-tenant design — forms, submissions, and resources are scoped to
//    an Organization. Users belong to exactly ONE organization via
//    OrganizationMember. Role-based access (ADMIN, EDITOR, VIEWER) controls
//    what each member can do within their organization.
//
// 5. Platform-level SuperAdmin — a SystemRole enum on the User model allows
//    platform administrators to manage all organizations, view audit logs,
//    and perform platform-wide operations.
//
// 6. File Storage — MinIO (primary, self-hosted S3-compatible) with an
//    optional AWS S3 backend. A single StorageProvider enum & storage fields
//    on every file record means you can switch providers without touching code.
//
// 7. Async submission ingestion — API accepts and enqueues; workers persist.
//    The schema supports PENDING_UPLOAD state + a separate files table to
//    decouple the fast submission write from the slow file verification step.
//
// 8. Daily aggregated analytics — pre-aggregated counters in FormAnalytics
//    prevent O(n) COUNT(*) queries at dashboard read time.
//
// 9. Full Audit Logging — every significant action is recorded in AuditLog
//    with organization-level segregation. Only SuperAdmins can view audit
//    logs across organizations.
//
// INDEXING PHILOSOPHY:
// ─────────────────────────────────────────────────────────────────────────────
//  • Every foreign key has a corresponding @index.
//  • High-cardinality, frequently-filtered columns (status, submittedAt) have
//    compound indexes with formId to leverage Index-only scans.
//  • GIN index on answers JSONB is added via raw SQL in a Prisma migration:
//    CREATE INDEX idx_form_submissions_answers_gin
//    ON form_submissions USING GIN (answers jsonb_path_ops);
//
// PARTITIONING NOTE (run after >5M submission rows):
//    ALTER TABLE form_submissions RENAME TO form_submissions_default;
//    CREATE TABLE form_submissions (..., submitted_at TIMESTAMPTZ NOT NULL)
//    PARTITION BY RANGE (submitted_at);
//    -- Example: monthly partition
//    CREATE TABLE form_submissions_y2026m08 PARTITION OF form_submissions
//    FOR VALUES FROM ('2026-08-01') TO ('2026-09-01');
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // NOTE (Prisma 7): binaryTargets is gone. v7 replaced the Rust query engine
  // with the in-process query compiler, so there are no engine binaries to ship
  // and the Docker image no longer needs platform-specific downloads.
}

datasource db {
  // NOTE (Prisma 7): `url` is no longer permitted here. The connection is
  // supplied at runtime via a driver adapter (@prisma/adapter-pg) in
  // src/common/prisma/prisma.service.ts, and to the CLI via prisma.config.ts.
  // This is what lets us configure the pg Pool directly — see PrismaService for
  // the explicit per-process connection limits.
  provider = "postgresql"
}

// ============================================================================
// SECTION 1 — ENUMERATIONS
// ============================================================================

/// Lifecycle state of a Form.
/// DRAFT     — Invisible to respondents; freely editable without creating versions.
/// PUBLISHED — Accepts new submissions; any structural edit creates a new FormVersion.
/// ARCHIVED  — No new submissions accepted; historical data fully preserved.
/// CLOSED    — System-closed when maxSubmissions limit is hit or expiresAt is past.
enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
}

/// All supported question types — keep in sync with src/types/form.ts :: QuestionType.
enum QuestionType {
  SHORT_TEXT // Single-line text input
  LONG_TEXT // Multi-line textarea
  NUMBER // Numeric only input
  EMAIL // Email with RFC 5322 pattern validation
  PHONE // Phone number with international prefix support
  URL // URL with scheme validation
  SINGLE_CHOICE // Radio buttons — exactly one answer
  MULTI_CHOICE // Checkboxes — one or more answers
  DROPDOWN // Select/combobox — exactly one answer
  STAR_RATING // 1–5 star rating widget
  NPS // Net Promoter Score 0–10
  SLIDER // Numeric slider with configurable min/max/step
  DATE // Date picker
  FILE_UPLOAD // MinIO (or S3) file upload — see FormSubmissionFile
  SIGNATURE // Canvas-drawn signature stored as base64 DataURL in answers
  MATRIX // Row × Column grid of radio/checkbox answers
  SECTION_HEADER // Non-answerable visual divider between question groups
  REPEATING_SECTION // A section that can be duplicated multiple times by the respondent
}

/// Conditional logic operators for skip logic and show/hide rules.
enum LogicOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  GREATER_THAN
  LESS_THAN
  IS_FILLED // True when the target field has any non-empty value
}

/// Action to take when a LogicRule condition evaluates to true.
enum LogicAction {
  SHOW // Make a hidden question visible
  HIDE // Conceal a visible question
  JUMP_TO_PAGE // Skip forward or backward to a specific page number
}

/// Lifecycle state of a form submission record.
/// Workers update this field after async processing completes.
enum SubmissionStatus {
  SUBMITTED // Successfully ingested and persisted by the worker
  FLAGGED_SPAM // Detected as bot or spam by the validation/rate-limit layer
  REJECTED // Manually rejected by the form owner via admin panel
  DELETED // Soft-deleted; hidden from UI but retained for audit purposes
}

/// Lifecycle state of an uploaded file attached to a submission answer.
/// Tracks the file through MinIO/S3 → verification → optional quarantine pipeline.
enum FileUploadStatus {
  PENDING_UPLOAD // Presigned PUT URL issued; client upload not yet confirmed
  VERIFIED // Object confirmed in storage and passed MIME + size checks
  QUARANTINED // Flagged as dangerous by ClamAV or content scanner
  DELETED // Object removed from MinIO/S3; record kept for audit trail
}

/// Identifies which object-storage backend holds a given file.
/// Storing this per-record allows transparent provider migration.
/// MINIO — Self-hosted MinIO server (default; recommended for local/self-hosted)
/// S3    — AWS S3 (optional; activate by setting STORAGE_PROVIDER=s3 in env)
enum StorageProvider {
  MINIO
  S3
}

/// Platform-level role for the User account.
/// USER        — Standard platform user; access determined by OrgRole.
/// SUPER_ADMIN — Full platform admin; can manage all organizations, view
///               all audit logs, suspend orgs, and access platform dashboard.
enum SystemRole {
  USER
  SUPER_ADMIN
}

/// Organization-level role assigned via OrganizationMember.
/// ADMIN  — Full org control: CRUD forms, manage members, view all data.
///          The org creator is automatically assigned ADMIN.
/// EDITOR — Can create/edit forms and view submissions, but cannot
///          manage members or delete the organization.
/// VIEWER — Read-only access to forms and submissions. Can export data.
enum OrgRole {
  ADMIN
  EDITOR
  VIEWER
}

/// Status of an organization invitation.
/// PENDING  — Invite sent, waiting for acceptance.
/// ACCEPTED — Invite accepted, membership created.
/// EXPIRED  — Invite token past its expiresAt date.
/// REVOKED  — Invite manually cancelled by an admin.
enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============================================================================
// SECTION 2 — ORGANIZATION & MULTI-TENANCY
// ============================================================================

/// Organization — the tenant entity that owns all forms, submissions,
/// and resources within its scope.
///
/// DATA ISOLATION:
///  Every query for forms, submissions, analytics, webhooks, and files
///  includes an organizationId filter. No cross-org data leakage is
///  possible when all services enforce org-scoped queries.
///
/// QUOTAS:
///  Quota fields (maxForms, maxSubmissionsMonth, maxMembers, storageQuotaBytes)
///  are ready for future plan-based enforcement. Currently set to generous
///  defaults. SuperAdmin can manually adjust quotas per org.
///
/// STORAGE:
///  Each org can have its own MinIO bucket or S3 bucket for file isolation.
///  Falls back to the global MINIO_DEFAULT_BUCKET if not set.
model Organization {
  id      String  @id @default(uuid()) @db.Uuid
  /// Human-readable organization name shown in dashboards and UI.
  name    String  @db.VarChar(255)
  /// URL-safe unique slug for the organization. Used in API routes.
  slug    String  @unique @db.VarChar(120)
  /// Optional logo URL for the organization.
  logoUrl String? @map("logo_url") @db.Text

  // ── Quota Fields (future plan support) ──────────────────────────────────────
  /// Maximum number of forms this org can create. Default: 100 (generous).
  maxForms            Int    @default(100) @map("max_forms")
  /// Maximum submissions per calendar month. Default: 10000.
  maxSubmissionsMonth Int    @default(10000) @map("max_submissions_month")
  /// Maximum number of members in this org. Default: 50.
  maxMembers          Int    @default(50) @map("max_members")
  /// Storage quota in bytes. Default: 5GB.
  storageQuotaBytes   BigInt @default(5368709120) @map("storage_quota_bytes")
  /// Current storage usage in bytes. Updated by file upload workers.
  storageUsedBytes    BigInt @default(0) @map("storage_used_bytes")

  // ── Storage Configuration ───────────────────────────────────────────────────
  /// Org-specific MinIO bucket. NULL = use global MINIO_DEFAULT_BUCKET.
  minioBucket            String?         @map("minio_bucket") @db.VarChar(100)
  /// Org-specific AWS S3 bucket. NULL = use global AWS_S3_BUCKET.
  s3Bucket               String?         @map("s3_bucket") @db.VarChar(100)
  /// Default storage provider for this org. Inherits from global env if MINIO.
  defaultStorageProvider StorageProvider @default(MINIO) @map("default_storage_provider")

  // ── Organization Settings (JSONB) ────────────────────────────────────────────
  /// Flexible settings object for org-level feature flags, preferences, etc.
  /// Shape can evolve without schema migrations.
  settings Json? @db.JsonB

  // ── Lifecycle ────────────────────────────────────────────────────────────────
  /// Whether the org is currently active. Inactive orgs cannot create forms or accept submissions.
  isActive      Boolean   @default(true) @map("is_active")
  /// When the org was suspended by a SuperAdmin. NULL = not suspended.
  suspendedAt   DateTime? @map("suspended_at")
  /// Reason for suspension (filled by SuperAdmin).
  suspendReason String?   @map("suspend_reason") @db.Text
  /// Soft-delete timestamp. NULL = active.
  deletedAt     DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members            OrganizationMember[]
  invitations        OrganizationInvitation[]
  forms              Form[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  integrationConfigs IntegrationConfig[]
  subjectTypes       SubjectType[]
  subjects           Subject[]
  formApps           FormApp[]
  featureFlags       OrganizationFeatureFlag[]
  choiceLists        ChoiceList[]
  exportJobs         ExportJob[]

  @@index([slug])
  @@index([isActive])
  @@map("organizations")
}

/// Joins a User to an Organization with a specific role.
///
/// MULTI-ORG:
///  A user may belong to any number of organizations, with a different role in
///  each — the agency/consultant/contractor case. Only the (organizationId,
///  userId) pair is unique; there is deliberately no unique constraint on
///  userId alone.
///
///  Which org a session is "in" is NOT a property of this table: it is
///  User.lastActiveOrganizationId, and every org-scoped route takes :orgId from
///  the URL and re-checks membership via OrgMemberGuard. The active org is a UI
///  convenience, never an authorization decision.
///
/// ROLE HIERARCHY (enforced at guard level, not schema level):
///  ADMIN > EDITOR > VIEWER
///  The org creator is automatically assigned ADMIN role.
model OrganizationMember {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  /// The member's role within this organization.
  role           OrgRole @default(VIEWER)

  /// When this member joined the organization.
  joinedAt    DateTime @default(now()) @map("joined_at")
  /// The user who invited this member. NULL for org creators.
  invitedById String?  @map("invited_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id])

  // One membership per user per org (standard many-to-many guard)
  @@unique([organizationId, userId])
  // Lists every org for a user — drives the org switcher and /organizations.
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

/// Invitation to join an organization.
///
/// INVITATION FLOW:
///  1. Admin creates invitation → generates a unique token → returns invite link.
///  2. Invitee clicks the link → frontend calls POST /invitations/:token/accept.
///  3. If the invitee doesn't have an account, they register first, then accept.
///  4. On acceptance: OrganizationMember is created, invitation status → ACCEPTED.
///
/// TOKEN SECURITY:
///  The token is a 32-byte random hex string. Only the SHA-256 hash is stored
///  in the database. The raw token is shown once in the invite link URL.
///  Tokens expire after a configurable period (default: 7 days).
///
/// FUTURE: Email integration will send the invite link via SendGrid/Resend
///  in addition to returning the link in the API response.
model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// Email of the person being invited. Used for pre-matching when they register.
  email          String       @db.VarChar(255)
  /// Role to assign when the invite is accepted.
  role           OrgRole      @default(VIEWER)
  /// SHA-256 hash of the invite token (64 hex chars). Raw token shown once.
  token          String       @unique @db.VarChar(64)
  /// Current status of this invitation.
  status         InviteStatus @default(PENDING)

  /// The admin who created this invitation.
  invitedById String    @map("invited_by_id") @db.Uuid
  /// When this invitation expires. Default: 7 days from creation.
  expiresAt   DateTime  @map("expires_at")
  /// When the invite was accepted. NULL if not yet accepted.
  acceptedAt  DateTime? @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([token])
  @@index([email])
  @@map("organization_invitations")
}

// ============================================================================
// SECTION 3 — USER & AUTH
// ============================================================================

/// The platform user — can be a form creator, editor, viewer, or platform admin.
///
/// MULTI-TENANT DESIGN:
///  Users are linked to organizations via OrganizationMember (one org per user).
///  The user's role within the org is stored in OrganizationMember.role.
///  The user's platform-level role (USER vs SUPER_ADMIN) is stored here.
///
/// AUTHENTICATION:
///  • Password: argon2id hash (time=3, memory=64MB, parallelism=4). Never stored plain.
///  • Access Token: short-lived JWT (HS256, 15 min TTL).
///  • Refresh Token: opaque 32-byte random token, stored SHA-256 hashed here,
///    rotated on every /auth/refresh call to prevent replay attacks.
///  • Refresh Token is sent in an HttpOnly, Secure, SameSite=Strict cookie.
///
/// SOFT DELETE:
///  Users are soft-deleted (deletedAt) so that submission records remain
///  attributable to the creator without orphan FK violations.
model User {
  id            String  @id @default(uuid()) @db.Uuid
  email         String  @unique @db.VarChar(255)
  // argon2id hash. NEVER expose in API responses.
  passwordHash  String  @map("password_hash") @db.VarChar(255)
  firstName     String  @map("first_name") @db.VarChar(100)
  lastName      String  @map("last_name") @db.VarChar(100)
  avatarUrl     String? @map("avatar_url") @db.Text
  emailVerified Boolean @default(false) @map("email_verified")

  // ── Platform-Level Role ─────────────────────────────────────────────────────
  /// USER = standard user (org access via OrganizationMember).
  /// SUPER_ADMIN = platform administrator with global access.
  systemRole SystemRole @default(USER) @map("system_role")

  // ── Active Organization ────────────────────────────────────────────────────
  /// The org this user last worked in, used to pick a default workspace on
  /// login and to restore context across devices. A pointer only — never an
  /// authorization input. It may reference an org the user has since been
  /// removed from, so every read must re-verify membership and fall back.
  /// Intentionally not a foreign key: an org deletion should blank this
  /// lazily rather than cascade into the user row.
  lastActiveOrganizationId String? @map("last_active_organization_id") @db.Uuid

  // ── Storage Preferences ────────────────────────────────────────────────────
  // NULL = inherit global STORAGE_PROVIDER env var (default: MINIO)
  preferredStorage StorageProvider? @map("preferred_storage")

  // ── MFA ────────────────────────────────────────────────────────────────────
  mfaEnabled Boolean @default(false) @map("mfa_enabled")
  mfaSecret  String? @map("mfa_secret") @db.VarChar(255)

  // ── Soft Delete ────────────────────────────────────────────────────────────
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberships         OrganizationMember[]
  memberInvites       OrganizationMember[]     @relation("InvitedBy")
  invitationsSent     OrganizationInvitation[] @relation("InvitationsSent")
  createdForms        Form[]                   @relation("FormCreator")
  apiKeys             ApiKey[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  submittedForms      FormSubmission[]
  notifications       Notification[]
  formComments        FormComment[]

  emailVerificationTokens EmailVerificationToken[]
  mfaRecoveryCodes        MfaRecoveryCode[]
  auditLogs               AuditLog[]               @relation("AuditActor")

  reviewedSubmissions FormSubmission[] @relation("SubmissionReviewer")
  deletedSubmissions  FormSubmission[] @relation("SubmissionDeleter")
  exportJobs          ExportJob[]

  @@index([email])
  @@map("users")
}

/// Single-use MFA recovery codes.
///
/// Issued (10 at a time) when a user completes MFA enrolment and shown exactly
/// once. Only the argon2id hash is stored. Without these, a lost authenticator
/// device means the account is unrecoverable without manual support action.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// argon2id hash of the plaintext recovery code.
  codeHash  String    @map("code_hash") @db.VarChar(255)
  /// NULL until redeemed. A code may be used exactly once.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// Token used for email verification flows.
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // SHA-256 hex of the raw token (raw token is sent in email)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

/// Token used for password reset flows.
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // SHA-256 hex of the raw token (raw token is sent in email)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// Per-device JWT refresh token record.
/// SHA-256 hashed before storage — the raw token is shown to the user only once.
/// On every /auth/refresh request, the old record is revoked and a new one issued.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // SHA-256 hex of the raw 32-byte random token (64 hex chars).
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)

  /// Token FAMILY — every token descended from a single login shares this id.
  ///
  /// WHY: rotation alone does not detect theft. If an attacker steals a refresh
  /// token and uses it before the legitimate user does, the attacker gets a
  /// fresh token and the victim's next refresh simply fails — indistinguishable
  /// from an expired session, and the attacker keeps a working session forever.
  ///
  /// Presenting an ALREADY-REVOKED token is the signal: under normal operation
  /// a rotated token is never replayed, so a replay means the token leaked.
  /// The response is to revoke the entire family (OAuth 2.0 Security BCP
  /// §4.13.2), which logs out both the attacker and the victim — the victim can
  /// sign in again, the attacker cannot.
  ///
  /// Seeded to the row's own id at login, so a family is never empty.
  familyId  String    @map("family_id") @db.Uuid

  // Stored to display in "active sessions" admin UI, not for auth decisions.
  userAgent String?   @map("user_agent") @db.Text
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at")
  // NULL = token is still valid. Set to NOW() on logout or rotation.
  revokedAt DateTime? @map("revoked_at")
  /// Why the token stopped being valid. Distinguishes routine rotation from a
  /// security event, so "your session ended" and "we detected token reuse" can
  /// be different messages — and so the audit trail can be queried for the
  /// latter. NULL while the token is live.
  revokedReason RefreshTokenRevokeReason? @map("revoked_reason")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  /// The cascade-revoke query: every live token in a compromised family.
  @@index([familyId, revokedAt])
  @@map("refresh_tokens")
}

/// Why a RefreshToken was revoked. See RefreshToken.familyId for the threat model.
enum RefreshTokenRevokeReason {
  ROTATED // Normal: exchanged for a successor during refresh.
  LOGOUT // User signed out explicitly.
  PASSWORD_RESET // All sessions dropped after a credential change.
  ADMIN_REVOKED // Super-admin ended the user's sessions.
  REUSE_DETECTED // A revoked token was replayed — the family was burned.
}

/// Machine-to-machine API key for programmatic access (CLI tools, integrations, scripts).
///
/// KEY FORMAT: fbk_<base62_32_bytes>
///  — The "fbk_" prefix helps secrets-scanning tools (GitHub, GitGuardian) detect leaks.
///  — Only the SHA-256 hex hash is stored here. The raw key is shown once on creation.
///
/// MULTI-TENANT: API keys are scoped to an organization. The organizationId
///  determines which org's data the key can access. Scopes further restrict
///  what operations are permitted.
///
/// SCOPES (comma-separated, enforced at service layer):
///  forms:read, forms:write, submissions:read, submissions:export
model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// The organization this API key is scoped to.
  organizationId String    @map("organization_id") @db.Uuid
  // Human-readable label (e.g., "Zapier Integration", "Export Script")
  name           String    @db.VarChar(100)
  // SHA-256 hex of the raw key (64 chars). Used for lookup on every API request.
  keyHash        String    @unique @map("key_hash") @db.VarChar(64)
  // Comma-separated scope string. Default: read-only.
  scopes         String    @default("forms:read,submissions:read") @db.VarChar(500)
  lastUsedAt     DateTime? @map("last_used_at")
  // NULL = never expires
  expiresAt      DateTime? @map("expires_at")
  /// Soft revoke. A hard DELETE would erase the audit trail of what the key was
  /// permitted to do and when it was last used — exactly what an incident
  /// review needs. Revoked keys stay listed, greyed out, and never authenticate.
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

// ============================================================================
// SECTION 4 — FORM CREATION, VERSIONING & CONFIGURATION
// ============================================================================

/// Central Form entity — the permanent, stable identifier for a form.
///
/// MULTI-TENANT: Forms are owned by an Organization, not a User.
/// The createdById field tracks which user originally created the form,
/// but all access control is based on organizationId + OrganizationMember role.
///
/// The form's actual question/logic/theme content lives in FormVersion snapshots.
/// The Form model holds only stable metadata and configuration flags.
///
/// PUBLISHING WORKFLOW:
///  1. Creator builds a form in DRAFT status (no versions yet, no submissions).
///  2. Creator clicks "Publish" → FormVersion 1 is created as an immutable snapshot.
///  3. Creator edits a PUBLISHED form → a new FormVersion 2 is atomically created.
///     form.currentVersion = 2. All NEW submissions reference version 2.
///     All existing submissions continue to reference version 1 (immutable).
///  4. Creator closes or archives the form via API/UI.
model Form {
  id             String @id @default(uuid()) @db.Uuid
  /// The organization that owns this form. All access checks use this field.
  organizationId String @map("organization_id") @db.Uuid
  /// The user who originally created this form. For attribution, not access control.
  createdById    String @map("created_by_id") @db.Uuid

  // ── Public URL Slug ────────────────────────────────────────────────────────
  // Auto-generated as a nanoid(10) at creation. Can be customized to a vanity slug.
  // Used in the public respondent URL: /fill/{slug}
  slug String @unique @db.VarChar(120)

  title       String     @db.VarChar(255)
  description String?    @db.Text
  status      FormStatus @default(DRAFT)

  // ── Layout Mode ────────────────────────────────────────────────────────────
  // DOCUMENT (default) | CONVERSATIONAL | GRID | PORTAL
  layoutMode String @default("DOCUMENT") @map("layout_mode") @db.VarChar(50)

  // ── Quiz Mode ──────────────────────────────────────────────────────────────
  // When true, questions carry `points` and `correctAnswer` fields.
  // The submission worker auto-grades responses and populates quizScore/isPassed.
  isQuizMode Boolean @default(false) @map("is_quiz_mode")

  // ── Access Control ─────────────────────────────────────────────────────────
  isPasswordProtected Boolean   @default(false) @map("is_password_protected")
  // argon2id hash of the form access password. NULL when not password-protected.
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  // When true, the respondent must be a logged-in User (useful for internal forms).
  requireAuth         Boolean   @default(false) @map("require_auth")
  // When false, duplicate submissions from the same fingerprint are rejected.
  allowMultiple       Boolean   @default(true) @map("allow_multiple")
  // System closes the form automatically once this many submissions are received.
  maxSubmissions      Int?      @map("max_submissions")
  // UTC datetime after which new submissions are rejected. NULL = never expires.
  expiresAt           DateTime? @map("expires_at")

  // ── Versioning Pointer ─────────────────────────────────────────────────────
  // The version number of the most recently published FormVersion.
  // Atomically incremented on each publish operation.
  currentVersion Int @default(1) @map("current_version")

  // ── Theme Configuration (JSONB) ────────────────────────────────────────────
  // Full FormTheme object. Matches src/types/form.ts :: FormTheme.
  // Shape: {
  //   preset: ThemePreset, primaryColor: string, backgroundColor: string,
  //   cardColor: string, textColor: string, fontFamily: string,
  //   borderRadius: 'none'|'sm'|'md'|'lg'|'full',
  //   cardVariant: 'card'|'elevated'|'glass'|'minimal',
  //   coverImageUrl?: string, logoUrl?: string
  // }
  themeConfig Json @map("theme_config") @db.JsonB

  // ── Draft Structure Snapshots ─────────────────────────────────────────────
  // These fields store the working draft of the form. When published, they are
  // copied into an immutable FormVersion snapshot.
  pagesJson     Json? @map("pages_json") @db.JsonB
  questionsJson Json? @map("questions_json") @db.JsonB
  logicJson     Json? @map("logic_json") @db.JsonB
  /// Draft rule set: calculated fields, multi-condition visibility, cross-field
  /// validation, conditional requirement. An array of FormRule (see
  /// common/rules/ast.ts). Compiled and frozen into FormVersion on publish.
  rulesJson     Json? @map("rules_json") @db.JsonB

  // ── Subject binding (optional) ─────────────────────────────────────────────
  /// Which kind of record this form belongs to, if any. NULL for standalone
  /// forms — which is every form that existed before subjects were introduced.
  subjectTypeId String?         @map("subject_type_id") @db.Uuid
  /// Whether submitting creates a subject or adds to an existing one.
  subjectRole   FormSubjectRole @default(NONE) @map("subject_role")

  // ── Email Notifications ────────────────────────────────────────────────────
  // JSON array of email addresses to notify on each new submission.
  // Example: ["owner@example.com", "team@example.com"]
  notifyEmails Json?     @map("notify_emails") @db.JsonB
  // ── Soft Delete ────────────────────────────────────────────────────────────
  deletedAt    DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subjectType        SubjectType?        @relation(fields: [subjectTypeId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("FormCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions           FormVersion[]
  submissions        FormSubmission[]
  analytics          FormAnalytics[]
  webhooks           FormWebhook[]
  comments           FormComment[]
  drafts             FormDraft[]
  integrationConfigs IntegrationConfig[]
  formAppSteps       FormAppStep[]
  exportJobs         ExportJob[]

  @@index([organizationId, status]) // Most common query: list the org's forms by status
  @@index([slug]) // Public form page lookup — hot path
  @@index([createdById]) // Forms created by a specific user
  @@map("forms")
}

/// Immutable published snapshot of a Form's questions, pages, logic, and theme.
///
/// WHY THIS EXISTS:
///  A form receiving 50,000 responses may have its questions edited mid-run.
///  Without versioning, old submissions become uninterpretable when questions are
///  deleted or reordered. FormVersion captures the EXACT structure at publish time.
///  Submissions always reference their specific formVersionId, preserving accuracy
///  forever regardless of future edits.
///
/// DATA STORED AS JSONB (matched types from src/types/form.ts):
///  pagesJson     → FormPage[]      { pageNumber, title, description? }
///  questionsJson → FormQuestion[]  { id, type, label, options, validation, points, ... }
///  logicJson     → LogicRule[]     { id, triggerQuestionId, operator, value, action, ... }
///  themeJson     → FormTheme       { preset, primaryColor, fontFamily, ... }
model FormVersion {
  id      String @id @default(uuid()) @db.Uuid
  formId  String @map("form_id") @db.Uuid
  // Sequential version number within this form. Starts at 1. Never reused.
  version Int

  // ── Immutable Structure Snapshots ─────────────────────────────────────────
  pagesJson     Json @map("pages_json") @db.JsonB
  questionsJson Json @map("questions_json") @db.JsonB
  logicJson     Json @map("logic_json") @db.JsonB
  themeJson     Json @map("theme_json") @db.JsonB

  /// The authored rules, exactly as published.
  rulesJson     Json @default("[]") @map("rules_json") @db.JsonB
  /// The CompiledPlan produced from rulesJson at publish time: calculations in
  /// dependency order, visibility/require/validate buckets, and the list of
  /// cross-form references to batch-resolve.
  ///
  /// Derived data, stored deliberately. Compilation validates and topologically
  /// sorts, so caching it here means the submit path only ever interprets — and
  /// it records precisely what was checked at publish, which a recompile from a
  /// later code version would not reproduce.
  compiledRules Json @default("{}") @map("compiled_rules") @db.JsonB

  // When this version was snapshotted and made active.
  publishedAt DateTime @default(now()) @map("published_at")

  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@unique([formId, version]) // Prevents duplicate version numbers within a form
  @@index([formId])
  @@map("form_versions")
}

// ============================================================================
// SECTION 5 — SUBMISSION ENGINE (HIGH-THROUGHPUT ASYNC PIPELINE)
// ============================================================================

/// Core submission record — created by background workers, NOT by the API directly.
///
/// HIGH-THROUGHPUT DESIGN:
///  1. API receives POST /fill/{slug}/submit
///  2. API validates CAPTCHA token + basic DTO shape
///  3. API pushes payload to BullMQ Redis queue
///  4. API immediately returns HTTP 202 Accepted { submissionId } (~15ms)
///  5. Worker dequeues → validates against FormVersion schema → scores quiz
///     → detects spam → writes this row → updates analytics → fires webhooks
///
/// ANSWER PAYLOAD SHAPE (JSONB):
///  {
///    "<questionId>": "text value",           // SHORT_TEXT, EMAIL, PHONE, URL, DATE
///    "<questionId>": 42,                     // NUMBER, SLIDER, NPS, STAR_RATING
///    "<questionId>": "option_value",         // SINGLE_CHOICE, DROPDOWN
///    "<questionId>": ["opt_a", "opt_c"],     // MULTI_CHOICE
///    "<questionId>": { "row1": "col2" },     // MATRIX: { rowValue: colValue }
///    "<questionId>": "<fileId>",             // FILE_UPLOAD: reference to FormSubmissionFile.id
///    "<questionId>": "data:image/png;base64,..." // SIGNATURE
///  }
///
/// POST-MIGRATION SQL (add GIN index for deep JSONB answer queries):
///  CREATE INDEX idx_form_submissions_answers_gin
///  ON form_submissions USING GIN (answers jsonb_path_ops);
model FormSubmission {
  id            String @id @default(uuid()) @db.Uuid
  formId        String @map("form_id") @db.Uuid
  // The exact form version this submission was filled against. Never changes.
  formVersionId String @map("form_version_id") @db.Uuid

  // NULL for anonymous respondents (most common case when requireAuth = false).
  respondentId String? @map("respondent_id") @db.Uuid

  // ── Privacy-safe Respondent Metadata ──────────────────────────────────────
  // Raw IP address is NEVER stored (GDPR compliance).
  // Instead, a daily-salted SHA-256 hash is stored for duplicate detection.
  // The daily salt rotates at midnight UTC, preventing long-term IP tracking.
  respondentIpHash String? @map("respondent_ip_hash") @db.VarChar(64)
  userAgent        String? @map("user_agent") @db.Text
  // ISO 3166-1 alpha-2 country code resolved by the worker via MaxMind GeoIP.
  country          String? @db.VarChar(2)
  // Time in milliseconds from when the respondent loaded the form to submission click.
  completionTimeMs Int     @default(0) @map("completion_time_ms")

  // ── Quiz Auto-grading ──────────────────────────────────────────────────────
  // Populated by the SubmissionProcessorWorker when form.isQuizMode = true.
  // quizScore    = sum of points for correct answers
  // maxQuizScore = sum of total possible points across all scored questions
  // isPassed     = quizScore >= form-level passing threshold (stored in questionsJson)
  quizScore    Float?   @map("quiz_score")
  maxQuizScore Float?   @map("max_quiz_score")
  isPassed     Boolean? @map("is_passed")

  // ── The Answer Payload ─────────────────────────────────────────────────────
  // See ANSWER PAYLOAD SHAPE in the doc comment above.
  answers Json @db.JsonB

  // ── Denormalised tenant + subject ──────────────────────────────────────────
  /// Copied from the form. Recommended by the platform audit long before
  /// subjects existed: every org-scoped submission query (list, count, export,
  /// analytics) currently joins through `forms` to reach the tenant, and
  /// partitioning needs the column present. Subject timelines make it
  /// unavoidable, so it lands here.
  ///
  /// Nullable only so the backfill can run online; treat it as required.
  organizationId String? @map("organization_id") @db.Uuid
  /// The record this submission belongs to. NULL for standalone forms.
  subjectId      String? @map("subject_id") @db.Uuid

  // ── Denormalised form-app provenance ───────────────────────────────────────
  // All three are NULL for a standalone form submission, which is most of them.
  //
  // `formAppStepId` is the load-bearing one. "How many progress checks does
  // this student have?" was previously answerable only by walking
  // FormAppSessionEntry → session → step, and `formId` cannot stand in for it:
  // one form may serve steps in two different apps, so counting by form would
  // silently merge two programmes' histories.
  appSessionId  String? @map("app_session_id") @db.Uuid
  formAppStepId String? @map("form_app_step_id") @db.Uuid
  /// The reporting period this entry was filed into. The counting dimension for
  /// a SUBJECT_PERIOD step.
  periodId      String? @map("period_id") @db.Uuid

  /// When the recorded thing actually HAPPENED, from the step's occurredAtKey.
  ///
  /// NOT NULL and defaulted to the submission time, deliberately rather than
  /// nullable with a read-time fallback: `ORDER BY COALESCE(occurred_at,
  /// submitted_at)` cannot use a btree index, so the timeline would sort its
  /// whole result set on every page load. Always-present keeps it index-only.
  occurredAt DateTime @default(now()) @map("occurred_at")

  /// The identity of a repeat, hashed from the step's `uniqueBy` answers —
  /// "month 3", "final assessment". NULL when the step declares no uniqueBy, or
  /// for standalone submissions.
  ///
  /// A partial UNIQUE index over (subject_id, form_app_step_id,
  /// occurrence_key) is what actually prevents a duplicate month. Application
  /// checks cannot: two coordinators submitting March for the same student at
  /// the same moment both read a count of zero and both pass.
  occurrenceKey String? @map("occurrence_key") @db.VarChar(80)

  status      SubmissionStatus @default(SUBMITTED)
  // submittedAt = timestamp the API received the request (used in analytics & display).
  submittedAt DateTime         @default(now()) @map("submitted_at")
  // processedAt = when the worker finished writing this record (for queue latency monitoring).
  processedAt DateTime?        @map("processed_at")

  // ── Review & moderation ────────────────────────────────────────────────────
  /// Free-text note left by a team member. INTERNAL ONLY — never returned on
  /// any public or respondent-facing route, and never included in exports that
  /// a respondent could receive.
  reviewNote   String?   @map("review_note") @db.Text
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")

  // ── Soft delete ────────────────────────────────────────────────────────────
  /// Set alongside status = DELETED. Two fields rather than one because status
  /// alone cannot answer "when" or "by whom", and a submission is evidence: a
  /// response deleted the day before a dispute is a different fact from one
  /// deleted a year earlier.
  ///
  /// Every read path must filter on this. The analytics counters deliberately
  /// do NOT decrement — a deleted response was still received, and quota is
  /// charged on receipt.
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  // Relations
  form        Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion FormVersion          @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  respondent  User?                @relation(fields: [respondentId], references: [id], onDelete: SetNull)
  subject     Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  files       FormSubmissionFile[]
  // SetNull throughout, never Cascade: a submission is evidence and must
  // outlive the app scaffolding that produced it. Restructuring an app — or
  // pruning an abandoned session — cannot be allowed to delete collected data.
  appSession    FormAppSession? @relation(fields: [appSessionId], references: [id], onDelete: SetNull)
  formAppStep   FormAppStep?    @relation(fields: [formAppStepId], references: [id], onDelete: SetNull)
  period        FormAppPeriod?  @relation(fields: [periodId], references: [id], onDelete: SetNull)
  reviewedBy  User?                @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  deletedBy   User?                @relation("SubmissionDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  // ── Critical Performance Indexes ─────────────────────────────────────────
  @@index([formId, submittedAt(sort: Desc)]) // Dashboard: paginate newest first
  @@index([formId, status]) // Filter SUBMITTED vs FLAGGED_SPAM
  @@index([formVersionId]) // Version-scoped analytics queries
  @@index([respondentId]) // All submissions by a logged-in user
  /// The subject timeline: every entry for one record, newest first.
  ///
  /// REPLACED [subjectId, submittedAt desc] rather than joining it — the
  /// timeline now orders by occurredAt, so the old index had no reader left.
  /// Net index count on this table is unchanged by the swap.
  @@index([subjectId, occurredAt(sort: Desc)])
  /// Step availability for one subject, in ONE grouped scan:
  ///   SELECT form_app_step_id, period_id, count(*) … GROUP BY 1, 2
  /// The alternative — a COUNT per step — turns opening a record into six or
  /// more round-trips, which is what makes longitudinal apps feel slow.
  @@index([subjectId, formAppStepId, periodId])
  // Org-scoped listing without joining through `forms`, and the shape a
  // partitioned table will need.
  @@index([organizationId, submittedAt(sort: Desc)])
  // Resolving a cross-form reference: "this subject's latest answer to form X".
  @@index([subjectId, formId, submittedAt(sort: Desc)])
  /// Every list/export/count now carries `deletedAt: null`. Without this the
  /// filter is applied after the index scan, so a form with many deleted rows
  /// pays for reading all of them on every page.
  @@index([formId, deletedAt, submittedAt(sort: Desc)])
  @@map("form_submissions")
}

// ============================================================================
// SECTION 6 — FILE UPLOADS (MINIO PRIMARY / AWS S3 OPTIONAL)
// ============================================================================

/// Tracks every file uploaded as a FILE_UPLOAD question answer.
///
/// ═══════════════════════════════════════════════════════════════════
/// MINIO UPLOAD FLOW (PRIMARY — self-hosted, default)
/// ═══════════════════════════════════════════════════════════════════
///  Step 1  — Frontend calls POST /v1/storage/presigned-url
///            Payload: { formId, questionId, fileName, mimeType, sizeBytes }
///
///  Step 2  — StorageService validates:
///            ✓ MIME type is in the allowlist (configurable per question)
///            ✓ sizeBytes ≤ MAX_FILE_SIZE_MB * 1024 * 1024 (default 25 MB)
///            Creates a FormSubmissionFile record with status=PENDING_UPLOAD.
///            Generates a MinIO presigned PUT URL (TTL: 15 min).
///            Returns: { uploadUrl, objectKey, fileId, expiresAt }
///
///  Step 3  — Frontend PUTs the binary file DIRECTLY to MinIO uploadUrl.
///            NestJS RAM is NOT involved. File bytes never pass through the API.
///
///  Step 4  — Frontend includes fileId in the submission answers JSON:
///            { "<questionId>": "<fileId>" }
///            Then POSTs the submission. API enqueues and returns 202.
///
///  Step 5  — FileVerifierWorker calls MinIO statObject(objectKey):
///            If found:   status → VERIFIED, verifiedAt = NOW()
///            If missing: status → DELETED (upload expired or was never completed)
///
///  Step 6  — ClamAV daemon scans the MinIO bucket (via inotify or webhook event).
///            If malware found: status → QUARANTINED, quarantineReason set.
///            Object moved to a separate quarantine bucket automatically.
///
/// OBJECT KEY CONVENTION (same for MinIO and S3):
///  uploads/{orgId}/{formId}/{submissionId}/{fileId}/{sanitizedOriginalName}
///  — orgId segment allows per-org lifecycle policies and easy cleanup
///  — submissionId allows bulk-delete when a submission is purged
///  — fileId makes keys globally unique even if the same filename is used twice
model FormSubmissionFile {
  id           String  @id @default(uuid()) @db.Uuid
  // FK to FormSubmission. Cascade-delete removes file records when submission is purged.
  // Nullable because the file record is created when the presigned URL is issued,
  // BEFORE the submission is actually submitted.
  submissionId String? @map("submission_id") @db.Uuid
  // The FILE_UPLOAD question this file was uploaded for (matches FormQuestion.id).
  questionId   String  @map("question_id") @db.VarChar(100)

  // ── Storage Backend ────────────────────────────────────────────────────────
  // Identifies which backend system holds this object. Defaults to MinIO.
  provider  StorageProvider @default(MINIO)
  // MinIO bucket name or AWS S3 bucket name where this object is stored.
  bucket    String          @db.VarChar(100)
  // The complete object key path (see OBJECT KEY CONVENTION above).
  objectKey String          @unique @map("object_key") @db.VarChar(512)

  // ── File Metadata ──────────────────────────────────────────────────────────
  // Sanitized original filename (special chars replaced with underscores).
  originalName String  @map("original_name") @db.VarChar(255)
  mimeType     String  @map("mime_type") @db.VarChar(100)
  // File size in bytes as BigInt to handle files >2 GB without overflow.
  sizeBytes    BigInt  @map("size_bytes")
  // SHA-256 hex checksum computed by worker post-upload. Used for integrity checks
  // and to detect bit-rot or tampering. NULL until VERIFIED.
  sha256Hash   String? @map("sha256_hash") @db.VarChar(64)

  // ── Lifecycle Tracking ─────────────────────────────────────────────────────
  status           FileUploadStatus @default(PENDING_UPLOAD)
  // When the presigned PUT URL was issued (not when the binary arrived in storage).
  issuedAt         DateTime         @default(now()) @map("issued_at")
  // When the presigned URL expires (issuedAt + PRESIGNED_URL_TTL_SECONDS).
  expiresAt        DateTime?        @map("expires_at")
  // Set by FileVerifierWorker when MinIO/S3 statObject confirms the file exists.
  verifiedAt       DateTime?        @map("verified_at")
  // Populated by ClamAV/scanner integration. E.g., "Eicar-Test-Signature".
  quarantineReason String?          @map("quarantine_reason") @db.Text

  submission FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionId])
  @@index([status]) // Worker efficiently queries PENDING_UPLOAD files for verification
  @@map("form_submission_files")
}

/// Pre-built templates that can be used to quickly create forms.
model FormTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  category    String   @db.VarChar(50) // e.g. "survey", "feedback", "registration"
  thumbnail   String?  @db.Text // Preview image URL
  formData    Json     @db.JsonB // { pages, questions, logic, theme }
  isPublic    Boolean  @default(true) // Whether it's available to all orgs
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("form_templates")
}

// ============================================================================
// SECTION 7 — ANALYTICS (PRE-AGGREGATED DAILY COUNTERS)
// ============================================================================

/// Daily aggregate metrics for a form.
///
/// WHY PRE-AGGREGATE INSTEAD OF COUNTING ON-THE-FLY?
///  At millions of rows, SELECT COUNT(*) FROM form_submissions WHERE form_id = ?
///  causes sequential scans even with indexes. Pre-aggregated daily rows (max 365
///  per form per year) make dashboard charts instant at any scale.
///
/// HOW IT IS UPDATED:
///  The SubmissionProcessorWorker runs an UPSERT after each successful submission:
///
///  INSERT INTO form_analytics (id, form_id, date, submissions, avg_completion_ms)
///  VALUES (gen_random_uuid(), $formId, NOW()::date, 1, $completionMs)
///  ON CONFLICT (form_id, date) DO UPDATE SET
///    submissions     = form_analytics.submissions + 1,
///    avg_completion_ms = (form_analytics.avg_completion_ms + EXCLUDED.avg_completion_ms) / 2;
model FormAnalytics {
  id     String   @id @default(uuid()) @db.Uuid
  formId String   @map("form_id") @db.Uuid
  // Date only (no time). One row per form per calendar day (UTC).
  date   DateTime @db.Date

  // ── Daily Counters ─────────────────────────────────────────────────────────
  views           Int    @default(0) // Public form URL page loads
  starts          Int    @default(0) // First field interaction recorded
  submissions     Int    @default(0) // Successfully persisted submissions
  /// Sum of completionTimeMs across all submissions on this date.
  /// Required to compute a TRUE mean: the previous implementation used
  /// (existing + new) / 2, which is an exponential recency-weighted average
  /// and drifts far from the real average as volume grows.
  sumCompletionMs BigInt @default(0) @map("sum_completion_ms")
  /// Derived: sumCompletionMs / submissions. Maintained by the worker upsert.
  avgCompletionMs Int    @default(0) @map("avg_completion_ms")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, date]) // Enforces exactly one row per form per day for safe UPSERT
  @@index([formId, date])
  @@map("form_analytics")
}

// ============================================================================
// SECTION 8 — WEBHOOKS & DELIVERY LOGS
// ============================================================================

/// Webhook endpoint registered for a form.
model FormWebhook {
  id        String   @id @default(uuid()) @db.Uuid
  formId    String   @map("form_id") @db.Uuid
  // The HTTPS endpoint that will receive POST requests.
  url       String   @db.Text
  // 32-byte random hex secret. Stored encrypted at rest. Shown only once at creation.
  secret    String   @db.VarChar(255)
  // Human-readable label shown in the UI.
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  form       Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([formId, isActive])
  @@map("form_webhooks")
}

/// Immutable log of each webhook delivery attempt.
model WebhookDelivery {
  id           String   @id @default(uuid()) @db.Uuid
  webhookId    String   @map("webhook_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  statusCode   Int?     @map("status_code")
  responseBody String?  @map("response_body") @db.Text
  attempt      Int      @default(1)
  success      Boolean  @default(false)
  deliveredAt  DateTime @default(now()) @map("delivered_at")

  webhook FormWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([submissionId])
  @@map("webhook_deliveries")
}

// ============================================================================
// SECTION 9 — AUDIT LOGGING
// ============================================================================

/// Immutable audit log entry for tracking user actions within an organization.
///
/// DESIGN:
///  Every significant mutation (create, update, delete, invite, role change, etc.)
///  is logged with the actor, action, resource, and a metadata JSONB blob for
///  additional context (old/new values, etc.).
///
/// ACCESS:
///  Only SUPER_ADMIN can view audit logs. Logs are segregated by organizationId
///  so the SuperAdmin can filter by org for investigation.
///
/// RETENTION:
///  Audit logs are append-only and never deleted. Consider partitioning by
///  createdAt after the table exceeds 10M rows.
model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  /// The organization this action occurred within.
  ///
  /// NULL for a PLATFORM-level action, which genuinely belongs to no tenant —
  /// a super admin curating the global choice-list dictionary every org reads,
  /// for instance. These were previously unrecordable: the column was NOT NULL,
  /// so the only options were to invent an organization or to skip the audit
  /// entry, and skipping it left the platform's most widely-shared data with no
  /// trail of who changed it.
  organizationId String? @map("organization_id") @db.Uuid
  /// The user who performed the action. NULL for system-triggered events.
  userId         String? @map("user_id") @db.Uuid
  /// Dot-notation action name. Examples:
  ///  "form.created", "form.published", "form.deleted",
  ///  "member.invited", "member.removed", "member.role_changed",
  ///  "org.settings_updated", "org.suspended", "submission.rejected"
  action         String  @db.VarChar(100)
  /// The type of resource affected. Examples: "form", "member", "org", "submission"
  resource       String  @db.VarChar(50)
  /// The ID of the affected resource. NULL for org-level actions.
  resourceId     String? @map("resource_id") @db.VarChar(100)
  /// Additional context as JSONB. Examples:
  ///  { "oldRole": "VIEWER", "newRole": "EDITOR" }
  ///  { "formTitle": "Customer Survey" }
  ///  { "invitedEmail": "user@example.com" }
  metadata       Json?   @db.JsonB
  /// IP address of the actor at the time of the action.
  ipAddress      String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The actor.
  ///
  /// `userId` was already stored but had no relation, so reading an audit log
  /// gave you a bare UUID and the UI had no way to show who did anything. This
  /// adds only the relation — the column and its index already exist, so the
  /// migration carries a foreign key and nothing else.
  ///
  /// SetNull, not Cascade: deleting a user must never erase the record of what
  /// they did.
  user User? @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ============================================================================
// SECTION 10 — COLLABORATION (FORM COMMENTS)
// ============================================================================

/// Threaded comments on a form for team collaboration.
///
/// Team members can leave comments on forms for discussion, review requests,
/// or general notes. Comments support threading via parentId.
/// Admins/editors can mark comments as resolved.
model FormComment {
  id        String   @id @default(uuid()) @db.Uuid
  formId    String   @map("form_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// The comment text content.
  content   String   @db.Text
  /// Parent comment ID for threaded replies. NULL for top-level comments.
  parentId  String?  @map("parent_id") @db.Uuid
  /// Whether this comment thread has been resolved.
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  form    Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  parent  FormComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies FormComment[] @relation("CommentThread")

  @@index([formId])
  @@index([userId])
  @@map("form_comments")
}

// ============================================================================
// SECTION 11 — IN-APP NOTIFICATIONS
// ============================================================================

/// In-app notification for a user.
///
/// Notifications are created by various system events:
///  - New submission received (for form creators)
///  - Member joined organization
///  - Invitation accepted
///  - Form published
///  - Quota limit approaching
///  - etc.
///
/// The metadata JSONB blob contains event-specific context for deep linking
/// in the frontend (e.g., formId, submissionId, orgId).
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Notification type for filtering and icon selection.
  /// Examples: "new_submission", "member_joined", "form_published", "quota_warning"
  type      String   @db.VarChar(50)
  /// Short title displayed in the notification dropdown.
  title     String   @db.VarChar(255)
  /// Optional longer description.
  body      String?  @db.Text
  /// Event-specific context for deep linking.
  /// Example: { "formId": "uuid", "submissionId": "uuid" }
  metadata  Json?    @db.JsonB
  /// Whether the user has seen/read this notification.
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================================================
// SECTION 12 — INTEGRATIONS & SYNC
// ============================================================================

/// Bi-directional sync configurations (Airtable, Notion, Webhooks, etc.)
model IntegrationConfig {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  formId         String?  @map("form_id") @db.Uuid // null = org-wide integration
  provider       String   @db.VarChar(50) // e.g. "airtable", "notion"
  credentials    Json     @db.JsonB // Encrypted OAuth tokens/keys
  syncRules      Json     @db.JsonB // Field mappings and directions
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         Form?        @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([formId])
  @@map("integration_configs")
}

// ============================================================================
// SECTION 13 — PARTIAL SUBMISSIONS (DRAFTS)
// ============================================================================

/// Partial submission recovery (saves progress via browser fingerprint or session ID)
model FormDraft {
  id          String   @id @default(uuid()) @db.Uuid
  formId      String   @map("form_id") @db.Uuid
  fingerprint String   @db.VarChar(128)
  answers     Json     @db.JsonB
  lastFieldId String?  @map("last_field_id") @db.VarChar(100)
  progress    Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, fingerprint])
  @@index([formId, updatedAt])
  @@map("form_drafts")
}

// ═══════════════════════════════════════════════════════════════════════════
// SUBJECTS — the longitudinal record
// ═══════════════════════════════════════════════════════════════════════════

/// What role a form plays for a subject type.
enum FormSubjectRole {
  /// Not linked to any subject. Every pre-existing form is this.
  NONE
  /// Submitting this form creates a Subject.
  REGISTERS
  /// Submitting this form adds an entry to an existing Subject.
  ATTACHES
}

/// A kind of thing an organization keeps records about — "Patient",
/// "Household", "Farm", "Vehicle".
///
/// Deliberately shallow. Avni layers Programs and Encounter Types above this;
/// we stop here, because "a form that creates a record, and other forms that
/// add to it" covers the data-entry cases without an enrolment state machine.
model SubjectType {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(100)
  slug           String  @db.VarChar(60)
  /// Optional icon/emoji for the app switcher.
  icon           String? @db.VarChar(16)

  /// The form whose submission creates a subject of this type. Nullable so a
  /// type can be defined before its registration form is built.
  registrationFormId String? @map("registration_form_id") @db.Uuid

  /// Which question keys are promoted onto Subject.
  /// { displayName: ["first_name","last_name"], attributes: ["phone","village"],
  ///   externalId: "patient_number" }
  /// Keys, not question ids: a form can be re-published with new ids for the
  /// same logical field, and this config should survive that.
  identityConfig Json @default("{}") @map("identity_config") @db.JsonB

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjects     Subject[]
  forms        Form[]
  formApps     FormApp[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("subject_types")
}

/// One record — a person, household, asset — that accumulates submissions.
model Subject {
  id             String @id @default(uuid()) @db.Uuid
  /// Denormalised from subjectType. Every subject query is org-scoped, and
  /// carrying the column makes them index-only instead of a join — the same
  /// reason FormSubmission gained it.
  organizationId String @map("organization_id") @db.Uuid
  subjectTypeId  String @map("subject_type_id") @db.Uuid

  /// Derived from identityConfig.displayName. What search results show.
  displayName String  @map("display_name") @db.VarChar(200)
  /// Promoted subset of registration answers, for search, filter and prefill.
  /// The full answers always remain on the submission; this is a projection.
  attributes  Json    @default("{}") @db.JsonB
  /// Stable caller-supplied key (patient number, household code). The hard
  /// de-duplication guarantee; fuzzy matching is deliberately not attempted.
  externalId  String? @map("external_id") @db.VarChar(100)

  /// The submission that created this subject.
  registrationSubmissionId String? @unique @map("registration_submission_id") @db.Uuid

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectType  SubjectType      @relation(fields: [subjectTypeId], references: [id], onDelete: Restrict)
  submissions  FormSubmission[]
  appSessions  FormAppSession[]

  /// NULL externalIds do not collide in Postgres, so subjects without one are
  /// unconstrained — which is the intent.
  @@unique([subjectTypeId, externalId])
  @@index([organizationId, subjectTypeId, displayName])
  @@index([organizationId, createdAt])
  @@map("subjects")
}

// ═══════════════════════════════════════════════════════════════════════════
// FORM APPS — bundled data-entry surface
// ═══════════════════════════════════════════════════════════════════════════

/// A data-entry app over one subject type: search, register, timeline, record.
model FormApp {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  subjectTypeId  String @map("subject_type_id") @db.Uuid

  name        String  @db.VarChar(120)
  slug        String  @db.VarChar(60)
  description String? @db.Text
  icon        String? @db.VarChar(16)

  /// { dashboardCards: [{ title, source, filter }] }
  ///
  /// `formIds` USED to live here and is now superseded by FormAppStep — a bare
  /// list of ids could not say how many times a form is filled, in what order,
  /// or under what condition, which is the whole substance of an app. The
  /// migration backfills each id into a SINGLE step and the service no longer
  /// reads it.
  config      Json    @default("{}") @db.JsonB
  isPublished Boolean @default(false) @map("is_published")

  // ── Public surface ─────────────────────────────────────────────────────────
  /// Public URL segment: /a/{publicSlug}. Deliberately NOT `slug`: that one is
  /// the internal handle used in admin URLs and audit entries, and an
  /// organization must be able to change its public link — or retire it by
  /// setting this to NULL — without rewriting either.
  publicSlug String? @unique @map("public_slug") @db.VarChar(60)

  /// Full FormTheme, same shape as Form.themeConfig. An app is a branded
  /// surface in its own right, not a bare index of forms.
  themeConfig Json @default("{}") @map("theme_config") @db.JsonB

  /// { logoUrl, coverImageUrl, headerTitle, footerText }
  /// URLs are scheme-checked on write, like the form theme's — these are
  /// interpolated into `src` on a public page.
  branding Json @default("{}") @db.JsonB

  // ── Reporting windows ──────────────────────────────────────────────────────
  /// NONE unless an author says otherwise. An app that had hand-made periods
  /// before this column existed is migrated to FIXED, so its behaviour — closed
  /// outside its windows — is preserved exactly.
  periodMode FormAppPeriodMode @default(NONE) @map("period_mode")

  /// Read only when `periodMode` is RECURRING.
  ///
  ///   { cadence: "MONTHLY" | "QUARTERLY" | "WEEKLY" | "YEARLY",
  ///     anchor: "2026-01-01",   // where the cycle counts from
  ///     graceDays: 10,          // how long a closed window still accepts data
  ///     backfillPeriods: 2 }    // how many closed windows back may be chosen
  ///
  /// Grace and backfill exist because field data arrives late by nature. A
  /// worker who visited on the 28th and reaches a keyboard on the 3rd must be
  /// able to file it under the month it happened, not the month they typed it.
  periodConfig Json @default("{}") @map("period_config") @db.JsonB

  /// Respondents must be signed in. Defaults to TRUE: an app registers records
  /// against a subject, which is a heavier act than answering a survey, and
  /// the safe default for something that writes to a registry is closed.
  requireAuth Boolean @default(true) @map("require_auth")
  /// Sessions may be left and resumed. Off means a session must be completed in
  /// one sitting.
  allowDrafts Boolean @default(true) @map("allow_drafts")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectType  SubjectType      @relation(fields: [subjectTypeId], references: [id], onDelete: Restrict)
  steps        FormAppStep[]
  sessions     FormAppSession[]
  periods      FormAppPeriod[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("form_apps")
}

/// One step of an app: a form, and how many times it is filled.
///
/// This is what turns "a list of forms" into a programme. The reference form
/// this models has a respondent block answered once, two optional repeatable
/// training blocks, and a repeatable school-visit block — an ordering and a
/// cardinality that a `formIds` array cannot express.
model FormAppStep {
  id     String @id @default(uuid()) @db.Uuid
  appId  String @map("app_id") @db.Uuid
  formId String @map("form_id") @db.Uuid

  /// Stable handle for `showWhen` expressions, analytics and session entries.
  /// Renaming the title must not break a condition that points at this step.
  key         String  @db.VarChar(60)
  order       Int
  title       String  @db.VarChar(200)
  description String? @db.VarChar(500)
  icon        String? @db.VarChar(16)

  mode       FormAppStepMode @default(SINGLE)
  minEntries Int             @default(0) @map("min_entries")
  maxEntries Int?            @map("max_entries")
  /// Renders the "Optional" badge and relaxes the minimum to zero.
  isOptional Boolean         @default(false) @map("is_optional")

  /// WHERE `minEntries`/`maxEntries`/`uniqueBy` are counted.
  ///
  /// Until this existed they were counted within one sitting, which made them
  /// mean the wrong thing for anything longitudinal: `maxEntries: 6` on a
  /// monthly progress check meant six per SITTING, and `uniqueBy: ["month"]`
  /// could not stop month 3 being entered twice in two different sessions.
  /// SESSION is the default so every app that predates this behaves exactly as
  /// it did.
  scope FormAppStepScope @default(SESSION)

  /// Question key whose answer is the REAL-WORLD date of an entry, promoted
  /// onto the submission as `occurredAt`. A February visit typed up in March
  /// belongs in February; without this the timeline can only order by when
  /// somebody happened to be at a keyboard.
  occurredAtKey String? @map("occurred_at_key") @db.VarChar(60)

  /// When this step becomes DUE, relative to an anchor.
  ///
  ///   { anchor: "REGISTRATION" | "<stepKey>",
  ///     offsets: [{ months: 1 }, { months: 3 }, { months: 6 }],
  ///     graceDays: 14 }
  ///
  /// Advisory, never a gate: a step past its date is marked overdue and is
  /// still fillable, and one not yet due can still be filled early. Blocking on
  /// a schedule would mean a worker standing in front of the respondent cannot
  /// record what just happened, which is worse than a date being untidy.
  ///
  /// This is what lets the platform say "Ravi has no February check" — the one
  /// output a monitoring programme actually exists to produce, and the one
  /// thing a timeline of what DID happen can never show.
  schedule Json? @db.JsonB

  /// ExprNode over EARLIER steps' answers, addressed `stepKey.questionKey`.
  /// Evaluated with the same engine and the same fail-closed direction as a
  /// SHOW rule: a step whose condition cannot be evaluated is hidden, never
  /// revealed.
  showWhen Json? @map("show_when") @db.JsonB

  /// Question keys that must be distinct across this step's entries.
  /// `["school_name"]` is the reference form's "Duplicate schools not allowed".
  uniqueBy Json @default("[]") @map("unique_by") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app         FormApp               @relation(fields: [appId], references: [id], onDelete: Cascade)
  form        Form                  @relation(fields: [formId], references: [id], onDelete: Restrict)
  entries     FormAppSessionEntry[]
  submissions FormSubmission[]

  @@unique([appId, key])
  @@index([appId, order])
  @@index([formId])
  @@map("form_app_steps")
}

enum FormAppStepMode {
  /// Filled exactly once.
  SINGLE
  /// "+ Add …" — zero or more, bounded by min/maxEntries.
  REPEATABLE
}

/// The window a step's cardinality is measured over.
enum FormAppStepScope {
  /// Within one sitting. The original behaviour, and the default.
  SESSION
  /// Across the subject's whole history. "Registered once, ever."
  SUBJECT
  /// Per subject, per reporting period. "One progress check a month."
  SUBJECT_PERIOD
}

/// How an app's reporting windows come into being.
enum FormAppPeriodMode {
  /// No windows. Reports are accepted whenever the app is published.
  NONE
  /// Hand-made windows. The app is CLOSED outside them — the original
  /// behaviour, and still right for a survey that runs Feb–May and then stops.
  FIXED
  /// Windows derived from a cadence, computed rather than stored.
  ///
  /// A monthly programme under FIXED needs twelve hand-made rows a year and
  /// locks every worker out on the 1st. Under RECURRING the current window is a
  /// pure function of the cadence and the clock, and being between windows does
  /// not close the app — late entry is the normal case in field work, and
  /// refusing it is what makes people file under the wrong month.
  RECURRING
}

/// A reporting window. The reference form's "Feb – May 2026 · Fixed Reporting
/// Period" badge, and what segregates one cycle's returns from the next.
model FormAppPeriod {
  id       String   @id @default(uuid()) @db.Uuid
  appId    String   @map("app_id") @db.Uuid
  label    String   @db.VarChar(120)
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  isActive Boolean  @default(true) @map("is_active")

  /// Derived from the app's cadence rather than typed by an author.
  ///
  /// Generated rows are written LAZILY — at submit, never at open. Materialising
  /// on open would put a write on the hottest read path in the app, for a row
  /// that is only needed once something is actually filed against it.
  isGenerated Boolean @default(false) @map("is_generated")
  /// Position in the cadence, counted from its anchor. Lets a label be
  /// recomputed or a window be found without date arithmetic in SQL.
  sequence    Int?

  createdAt DateTime @default(now()) @map("created_at")

  app         FormApp          @relation(fields: [appId], references: [id], onDelete: Cascade)
  sessions    FormAppSession[]
  submissions FormSubmission[]

  /// Two concurrent submits into a not-yet-materialised window must converge on
  /// ONE row, or the same month would exist twice and `SUBJECT_PERIOD` counting
  /// would silently allow two entries. This is what makes the upsert safe.
  @@unique([appId, startsAt])
  @@index([appId, isActive])
  @@map("form_app_periods")
}

/// One sitting: everything between opening the app and "Submit All".
///
/// Answers are STAGED here and only become FormSubmissions at submit, in one
/// transaction. That is what makes the reference form's single submit button
/// honest — a half-submitted report, where some school visits landed and others
/// did not, is worse than a rejected one, because the respondent has no way to
/// tell which is which.
model FormAppSession {
  id             String  @id @default(uuid()) @db.Uuid
  appId          String  @map("app_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  periodId       String? @map("period_id") @db.Uuid

  /// REGISTER: resolved from the REGISTERS step at submit, NULL while a draft.
  /// FOLLOW_UP: bound when the session is OPENED, and never re-resolved.
  subjectId String? @map("subject_id") @db.Uuid

  /// Whether this session creates a record or adds to an existing one.
  ///
  /// Before FOLLOW_UP existed, adding March's progress check to a student meant
  /// re-filling their whole registration so the identity hash would land on the
  /// same Subject. That cost the worker a re-typed registration every visit,
  /// and one typo in a name silently minted a duplicate student.
  mode FormAppSessionMode @default(REGISTER)

  /// Steps this session is narrowed to, by key. Empty means "all of them".
  /// Set when a worker picks a single entry to add from a record page, so the
  /// runner shows one form rather than a six-step wizard with five skipped.
  stepKeys Json @default("[]") @map("step_keys") @db.JsonB

  status       FormAppSessionStatus @default(DRAFT)
  respondentId String?              @map("respondent_id") @db.Uuid
  /// Anonymous respondents, matching the public form draft mechanism.
  fingerprint  String?              @db.VarChar(64)

  startedAt        DateTime  @default(now()) @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  completionTimeMs Int?      @map("completion_time_ms")

  app         FormApp               @relation(fields: [appId], references: [id], onDelete: Cascade)
  period      FormAppPeriod?        @relation(fields: [periodId], references: [id], onDelete: SetNull)
  subject     Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  entries     FormAppSessionEntry[]
  submissions FormSubmission[]

  /// One open draft per respondent per app PER SUBJECT. Partial, so SUBMITTED
  /// sessions do not collide — a respondent files many reports over time, but
  /// resumes only the one they left open. Enforced by a partial unique index in
  /// the migration, which Prisma cannot express here.
  ///
  /// The subject is part of the key because a field worker mid-round has one
  /// unfinished visit per student, not one in total; keying on the respondent
  /// alone would make opening student B's form silently resume student A's.
  @@index([appId, status])
  @@index([organizationId, submittedAt])
  @@index([subjectId])
  @@map("form_app_sessions")
}

enum FormAppSessionStatus {
  DRAFT
  SUBMITTED
  ABANDONED
}

enum FormAppSessionMode {
  /// Starts from the REGISTERS step; the subject is resolved at submit.
  REGISTER
  /// Bound to an existing subject at open. Registration is skipped.
  FOLLOW_UP
}

/// One filled-in copy of one step. "School Visit #2" is `index: 1` here.
model FormAppSessionEntry {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  stepId    String @map("step_id") @db.Uuid

  index   Int
  /// Staged answers, keyed by question id. Copied into FormSubmission.answers
  /// at submit — after re-validation, never trusted as-is.
  answers Json @default("{}") @db.JsonB

  /// The version the respondent actually filled, pinned when the entry opened.
  /// A publish mid-session must not re-attribute answers to a new schema.
  formVersionId String @map("form_version_id") @db.Uuid

  /// Set once the session is submitted and the real submission exists.
  submissionId String? @unique @map("submission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session FormAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step    FormAppStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepId, index])
  @@index([sessionId])
  @@map("form_app_session_entries")
}

// ═══════════════════════════════════════════════════════════════════════════
// FEATURE FLAGS
// ═══════════════════════════════════════════════════════════════════════════

/// A platform capability that can be switched on or off.
///
/// Two levels, resolved as: organization override, else the global default.
/// That lets a super-admin dark-launch a feature (global OFF), enable it for a
/// pilot org, and later flip the global default without touching any org rows.
///
/// Keyed by a stable string rather than a uuid: flags are referenced by name in
/// code (`FORM_APPS`), and a generated id would mean a lookup to answer
/// "is this on?".
model FeatureFlag {
  key         String  @id @db.VarChar(60)
  name        String  @db.VarChar(120)
  description String? @db.Text

  /// Default for every organization without an explicit override.
  isEnabledGlobally Boolean @default(false) @map("is_enabled_globally")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  overrides OrganizationFeatureFlag[]

  @@map("feature_flags")
}

/// Per-organization override of a FeatureFlag. Presence means "decided here".
model OrganizationFeatureFlag {
  organizationId String  @map("organization_id") @db.Uuid
  flagKey        String  @map("flag_key") @db.VarChar(60)
  isEnabled      Boolean @map("is_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flag         FeatureFlag  @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@id([organizationId, flagKey])
  @@index([organizationId])
  @@map("organization_feature_flags")
}

// ═══════════════════════════════════════════════════════════════════════════
// CHOICE LISTS
// ═══════════════════════════════════════════════════════════════════════════

/// A managed set of options a question draws from, instead of the author
/// re-typing them on every question.
///
/// WHY THIS EXISTS:
///  Options used to live only on the question, as a static array. That makes a
///  District dropdown a 784-row copy-paste per form, makes correcting a
///  renamed district a sweep across every form that mentions it, and makes
///  cascading selects (District -> Block -> School) impossible to express at
///  all. A list is authored once, referenced by many questions, and can carry
///  extra columns that a rule reads with lookup().
///
/// GLOBAL vs ORG-OWNED:
///  organizationId NULL = provided by the platform, visible to every tenant,
///  read-only to them. India's states and districts ship this way. Anything a
///  customer creates is org-owned and invisible to other tenants.
model ChoiceList {
  id             String  @id @default(uuid()) @db.Uuid
  /// NULL for a platform-global list. See above.
  organizationId String? @map("organization_id") @db.Uuid
  name           String  @db.VarChar(120)
  /// Referenced by FormQuestion.optionsSource.listSlug. Resolved within the
  /// org first, then falling back to global, so a tenant can shadow a global
  /// list with their own corrected copy.
  slug           String  @db.VarChar(60)
  description    String? @db.VarChar(500)

  /// The list whose items are this list's parents. Districts -> States.
  ///
  /// Self-referential rather than a generic hierarchy table: a list has at most
  /// one parent, which is exactly what a cascading select needs, and it keeps
  /// the item query a single indexed lookup with no join.
  parentListId String?      @map("parent_list_id") @db.Uuid
  parentList   ChoiceList?  @relation("ChoiceListHierarchy", fields: [parentListId], references: [id], onDelete: SetNull)
  childLists   ChoiceList[] @relation("ChoiceListHierarchy")

  /// Declared metadata columns: [{ key, label, type }]. Drives the import
  /// column mapper and the lookup() field picker in the rules editor. Items
  /// are stored as JSONB regardless — this is authoring metadata, not a
  /// runtime constraint.
  metadataSchema Json @default("[]") @map("metadata_schema") @db.JsonB

  /// Bumped on every item mutation. The public items endpoint is cached on it,
  /// so editing a list invalidates its cache without a key sweep.
  version   Int @default(1)
  /// Denormalised count, maintained on import/mutation. Listing lists must not
  /// COUNT(*) across a million-row school registry.
  itemCount Int @default(0) @map("item_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ChoiceItem[]

  /// Two orgs may both have a "districts" list; one org may not have two.
  /// Global lists (NULL org) collide on slug only with each other — Postgres
  /// treats NULLs as distinct in a unique index, so uniqueness of global slugs
  /// is enforced by a partial index in the migration, not here.
  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@index([parentListId])
  @@map("choice_lists")
}

/// One option within a ChoiceList.
model ChoiceItem {
  id     String @id @default(uuid()) @db.Uuid
  listId String @map("list_id") @db.Uuid

  /// What lands in the answer. IMMUTABLE once in use: changing `label` is
  /// safe and cosmetic, changing `value` orphans every historical answer.
  value String @db.VarChar(120)
  label String @db.VarChar(300)

  /// The parent list item this one sits under. NULL for a root list.
  ///
  /// Stores the parent's VALUE, not its id, because the cascade filter runs
  /// against the answer the respondent gave — which is a value. One indexed
  /// lookup, no join, and it survives a re-import that regenerates item ids.
  parentValue String? @map("parent_value") @db.VarChar(120)

  /// Extra columns: udise_code, school_type, pincode, gstin. This is what
  /// lookup() reads to auto-fill a read-only field.
  metadata Json @default("{}") @db.JsonB

  sortOrder Int     @default(0) @map("sort_order")
  /// Retired options stay for historical answers but are not offered.
  isActive  Boolean @default(true) @map("is_active")

  list ChoiceList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, value])
  /// The cascade query: items of this list under this parent, active only.
  @@index([listId, parentValue, isActive])
  /// Type-ahead search on label.
  @@index([listId, label])
  @@map("choice_items")
}

// ============================================================================
// SECTION 15 — ASYNC EXPORT JOBS
// ============================================================================

/// Lifecycle of an asynchronous export.
enum ExportJobStatus {
  QUEUED // Accepted, waiting for a worker.
  RUNNING // A worker is streaming rows into object storage.
  COMPLETED // Object written; objectKey is set and downloadable.
  FAILED // Gave up. `error` explains why; BullMQ retries are already exhausted.
  EXPIRED // Object passed its retention window and was swept from the bucket.
}

/// Output encoding for an export.
enum ExportJobFormat {
  CSV
  JSON
}

/// A long-running export, decoupled from the HTTP request that asked for it.
///
/// WHY THIS EXISTS:
///  `GET /forms/:id/export` already streams with a keyset cursor, so it no
///  longer buffers the whole result set in memory. But it still holds one HTTP
///  connection, one Node worker slot and one database cursor open for the
///  entire duration — and a load balancer with a 60-second idle timeout will
///  cut a large export in half regardless of how efficiently it streams.
///  A truncated CSV is worse than a failed one: it arrives, it opens, and it
///  looks complete.
///
///  So exports past a threshold become jobs: the request returns an id
///  immediately, a worker streams rows into object storage, and the user gets a
///  presigned link when it lands. Retention is deliberately short — an export
///  is a derived artefact that can always be regenerated, and it contains a
///  full copy of the tenant's response data, which is the last thing that
///  should accumulate indefinitely in a bucket.
model ExportJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// NULL means an org-wide export rather than a single form's.
  formId         String? @map("form_id") @db.Uuid
  /// Who asked. Used for the notification and for the audit trail.
  requestedById  String @map("requested_by_id") @db.Uuid

  status ExportJobStatus @default(QUEUED)
  format ExportJobFormat @default(CSV)

  /// Frozen copy of the filters the request carried (date range, status, search).
  /// Stored rather than re-derived so a completed export can always explain
  /// exactly what it contains, even after the form has since changed.
  filters Json @default("{}") @db.JsonB

  /// Rows written so far. Updated in batches, not per row — this is progress
  /// display, not an accounting record.
  rowsWritten Int  @default(0) @map("rows_written")
  /// Best-effort total for a progress bar. NULL until counted.
  rowsTotal   Int? @map("rows_total")

  /// Object storage location of the finished file. NULL until COMPLETED.
  objectKey String?         @map("object_key") @db.VarChar(500)
  bytes     BigInt?
  provider  StorageProvider @default(MINIO)

  /// Failure reason, surfaced to the user. Must stay free of internal detail:
  /// it is shown in the dashboard.
  error String? @db.Text

  /// When the stored object becomes eligible for sweeping. Enforced by a
  /// scheduled job AND by a bucket lifecycle rule, because a sweeper that
  /// silently stops running would otherwise retain response data forever.
  expiresAt   DateTime? @map("expires_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         Form?        @relation(fields: [formId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  /// The dashboard list: this org's exports, newest first.
  @@index([organizationId, createdAt(sort: Desc)])
  /// The sweeper: everything COMPLETED and past retention.
  @@index([status, expiresAt])
  @@index([formId])
  @@index([requestedById])
  @@map("export_jobs")
}
