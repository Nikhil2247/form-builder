# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...opting in for exactly one: .env.example holds no values, only the list of
# variables and what happens when each is set. It was being ignored along with
# the real .env files, which meant the operator instructions for the security
# and error-reporting settings existed only on whoever's laptop wrote them.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
